# Vehicle Intelligence Platform Environment Variables

# Active detector model configuration (options: improved_centernet, baseline_centernet, cbam_centernet, bifpn_centernet)
DETECTOR=improved_centernet

# Contact email for open-licensed image funnel requests (User-Agent header in Openverse and Wikimedia Commons requests)
CONTACT_EMAIL=developer@example.com

# Default confidence score threshold for vehicle detection (range: 0.1 - 0.9)
SCORE_THRESHOLD=0.35

# SQLite database file path
DATABASE_PATH=backend/data/runs.db
